{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>nnsnodnb/.github:renovate-config",
    "helpers:pinGitHubActionDigests"
  ],
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchFileNames": [".github/workflows/*.yml"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ]
}
