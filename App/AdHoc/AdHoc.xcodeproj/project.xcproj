{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "ja",
    "supported": [
      "Base",
      "en",
    ],
  },
  "files": [
    {
      "kind": "folder",
      "path": "AdHoc",
      "target-membership": [
        "AdHoc",
      ],
      "membership-exceptions": [
        {
          "target": "AdHoc",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "group", "name": "Frameworks" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/AdHoc.app", "id": "CF91AB8E2F57E442001EC12D", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "AdHoc",
      "id": "CF91AB8D2F57E442001EC12D",
      "product": "Products/AdHoc.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Crashlytics",
          "log-environment-variables": true,
          "input-paths": [
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}",
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Resources/DWARF/${PRODUCT_NAME}",
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Info.plist",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/GoogleService-Info.plist",
            "$(TARGET_BUILD_DIR)/$(EXECUTABLE_PATH)",
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Resources/DWARF/${PRODUCT_NAME}.debug.dylib",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "if [[ \"${CI}\" ]]; then",
            "  \"${SRCROOT}/../../.swiftpm/checkouts/firebase-ios-sdk/Crashlytics/run\"",
            "else",
            "  \"${BUILD_DIR%/Build/*}/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/run\"",
            "fi",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "product-name": "DependenciesInterfaces",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "DependenciesLive",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "NowPlayingPackage",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "95",
        "DEVELOPMENT_TEAM": "99649YXF6E",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "AdHoc/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "NowPlaying",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.music",
        "INFOPLIST_KEY_NSAppleMusicUsageDescription": "AppleMusicUsageDescription",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "3.3.0",
        "OTHER_LDFLAGS": "-ObjC",
        "PRODUCT_BUNDLE_IDENTIFIER": "moe.nnsnodnb.NowPlaying",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    },
  ],
  "build-settings": {
